#!/bin/sh
# Pre-commit gate: exactly the checks CI's lint+test jobs run, so a commit
# that passes here cannot fail CI for code-quality reasons (the toolchain is
# pinned by rust-toolchain.toml, so local clippy == CI clippy).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass in an emergency:  git commit --no-verify
set -e

echo "pre-commit: cargo fmt --check"
cargo fmt --check || {
    echo "pre-commit: formatting is off — run 'cargo fmt' and re-stage." >&2
    exit 1
}

echo "pre-commit: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets --quiet -- -D warnings

echo "pre-commit: cargo test --all-targets"
cargo test --all-targets --quiet

echo "pre-commit: all gates green"
